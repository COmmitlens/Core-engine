# ─────────────────────────────────────────────────────────────────────────────
# CommitLens — On-Premise Environment Template
# Copy this file to .env and fill in every value before starting the stack.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service Versions ─────────────────────────────────────────────────────────
# Pin each service to a specific release tag independently.
# Releases: https://github.com/COmmitlens
# To upgrade a service: change its version below, then run:
#   docker compose pull && docker compose up -d
CORE_VERSION=latest        # COmmitlens/Core-engine  (Go backend)
AI_VERSION=latest          # COmmitlens/core-ai      (Python FastAPI)
FRONTEND_VERSION=latest    # COmmitlens/twin-ai-fe   (Next.js)

# ── API Server ────────────────────────────────────────────────────────────────
PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# DB_URL takes priority at runtime; individual fields kept for tooling/reference.
DB_URL=postgres://commitlens:CHANGE_ME@postgres:5432/commitlens?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_NAME=commitlens
DB_USER=commitlens
DB_PASSWORD=CHANGE_ME          # use a strong random password

# ── Redis (asynq background queue) ───────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME       # use a strong random password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME           # minimum 32 random characters

# ── SMTP (outgoing email) ─────────────────────────────────────────────────────
# Works with any SMTP provider (Gmail, Mailgun, self-hosted Postfix/Mailhog, etc.)
PRIMARY_EMAIL=noreply@yourcompany.com
PRIMARY_EMAIL_PASSWORD=CHANGE_ME

# ── Domain / TLS (see deploy/nginx.conf, deploy/tls.sh) ──────────────────────
DOMAIN=commitlens.tech
LETSENCRYPT_EMAIL=you@example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://commitlens.tech
# Public URL the browser calls — same domain, routed to `app` via nginx /v1/.
# Baked into the Next.js image as a placeholder and substituted at container
# start (see frontend repo's docker-entrypoint.sh), so this must be set here,
# not at frontend build time.
NEXT_PUBLIC_API_URL=https://commitlens.tech/v1

# ── GitHub App (webhook + repository integration) ────────────────────────────
# 1. Go to https://github.com/settings/apps → New GitHub App
# 2. Set Webhook URL to https://api.yourcompany.com/v1/github/webhook
# 3. Download the private key (.pem) and paste its contents below (escape newlines as \n)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
githubwebhooksecret=CHANGE_ME  # random secret you set when creating the GitHub App

# ── GitHub OAuth (login with GitHub) ─────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
GITHUB_AUTH_CLIENT_ID=CHANGE_ME
GITHUB_AUTH_CLIENT_SECRET=CHANGE_ME
GITHUB_AUTH_REDIRECT_URL=https://api.yourcompany.com/v1/auth/github/callback

# ── Google OAuth (login with Google) ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URL=https://api.yourcompany.com/v1/auth/google/callback

# ── Azure OpenAI (AI analysis + vector embeddings) ───────────────────────────
# The team needs their own Azure subscription with an OpenAI resource deployed.
# Portal → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=CHANGE_ME
AZURE_OPENAI_MODEL=gpt-4o          # your deployment name (not the base model name)
AZURE_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<embed-deployment>/embeddings?api-version=2024-02-01

# ── Internal AI backend ───────────────────────────────────────────────────────
# Not read from here in docker-compose.yml (it's hardcoded to http://ai:9000
# there, matching the `ai` service name and the port core-ai's uvicorn
# actually binds — see core-ai/entrypoint.sh). Kept here for local/non-compose runs.
AI_BACKEND_URL=http://localhost:9000